{
  "name": "@currency-quiz/contract",
  "version": "1.0.0",
  "private": true,
  "description": "Shared OpenAPI contract and generated TypeScript types for Currency Quiz",
  "type": "module",
  "types": "./generated/typescript/schema.d.ts",
  "exports": {
    ".": {
      "types": "./generated/typescript/schema.d.ts"
    }
  },
  "files": [
    "openapi",
    "generated/typescript"
  ],
  "scripts": {
    "generate": "node scripts/generate-typescript.mjs",
    "lint": "redocly lint openapi/currency-quiz.v1.yaml",
    "check": "npm run lint && npm run generate -- --check && tsc --noEmit"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@redocly/cli": "2.72.1",
    "typescript": "7.0.2"
  }
}
